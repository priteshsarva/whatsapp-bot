# same value as WA_INTERNAL_KEY in the backend .env (32+ random chars)
WA_INTERNAL_KEY=777ef3305cdc3b7799404119875dd11f7d1e04287fc3a354
# your personal number — escalated questions go here, your replies come from here
OWNER_PHONE=919408386083
AUTH_DIR=./auth
# the bot only takes part in chats that start on/after this date (IST); older chats are left alone
GO_LIVE=2026-09-21
# follow-up nudges: after N quiet days, at most M times per silence (10:00–19:00 IST only)
FOLLOWUP_DAYS=2
FOLLOWUP_MAX=2
# minutes the bot stays quiet in a chat after you type there yourself
PAUSE_MIN=30
# wait for them to finish typing before replying (ms), and the longest total hold
REPLY_WAIT_MS=8000
REPLY_MAX_WAIT_MS=60000
# quiet hours (IST): nothing is sent to a client between these; night messages wait for 6am
QUIET_FROM=1
QUIET_TO=6
# pick a chat back up if the owner hasn't answered in N minutes
REENGAGE_MIN=15
# the daily report goes out after this IST hour
REPORT_HOUR=20
